{
  "kind": "calendar_booking",
  "version": "0.1.0",
  "title": "Calendar Booking",
  "description": "Find shared Google Calendar availability, prepare an exact booking draft and create an event only after approval; preserve uncertain outcomes without resending.",
  "repository_url": "https://github.com/HackInvent/bloxmith-calendar-booking",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "python_distribution",
      "name": "httpx",
      "version": ">=0.28,<1"
    },
    {
      "type": "manual",
      "name": "Linux, Python 3.10+, IANA timezone data; Google Calendar API with OAuth free/busy and event-write permissions. Wallet must be unlocked."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "request",
        "title": "Calendar request",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "decision",
        "title": "Booking decision",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "slots",
        "title": "Available slots",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "draft",
        "title": "Booking draft",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "receipt",
        "title": "Booking receipt",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "booking_enabled": false,
    "credential_ref": "",
    "calendar_id": "",
    "timezone": "Europe/Paris",
    "participants": [],
    "business_hours": {
      "mon": [
        [
          "09:00",
          "17:00"
        ]
      ],
      "tue": [
        [
          "09:00",
          "17:00"
        ]
      ],
      "wed": [
        [
          "09:00",
          "17:00"
        ]
      ],
      "thu": [
        [
          "09:00",
          "17:00"
        ]
      ],
      "fri": [
        [
          "09:00",
          "17:00"
        ]
      ]
    },
    "horizon_days": 30,
    "step_minutes": 15,
    "buffer_minutes": 10,
    "min_notice_minutes": 30,
    "max_participants": 20,
    "max_slots": 10,
    "max_duration_minutes": 240,
    "draft_lifetime_sec": 900,
    "timeout_sec": 30,
    "max_records": 1000,
    "max_storage_bytes": 33554432
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
